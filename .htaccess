<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /web/

# Redirect /index or index.php to root / (GET/HEAD only)
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(?:/web)?/index(?:\.php)?[\s?] [NC]
RewriteRule ^ /web/ [R=301,L]

# Redirect /admin/index or /admin/index.php to /admin (GET/HEAD only)
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(?:/web)?/admin/index(?:\.php)?[\s?] [NC]
RewriteRule ^ /web/admin [R=301,L]

# Redirect /admin/index clean path to /admin (GET/HEAD only)
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
RewriteRule ^admin/index/?$ /web/admin [R=301,L]

# Redirect direct .php requests to clean URL (GET/HEAD only)
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(?:/web)?/([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# Redirect /index clean path to root (GET/HEAD only)
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
RewriteRule ^index/?$ /web/ [R=301,L]

# Existing files and directories serve directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Hide pages/ from URL if directly requested (GET/HEAD only)
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(?:/web)?/pages/([^\s?]+)(?:\.php)? [NC]
RewriteRule ^ /web/%1 [R=301,L]

# Public routes pointing to pages/
RewriteRule ^$ index.php [L]
RewriteRule ^about/?$ pages/about.php [L]
RewriteRule ^news/?$ pages/news.php [L]
RewriteRule ^news/([0-9]+)/?$ pages/news.php?id=$1 [L,QSA]
RewriteRule ^schedule/?$ pages/schedule.php [L,QSA]
RewriteRule ^teachers/?$ pages/teachers.php [L]
RewriteRule ^login/?$ pages/login.php [L]
RewriteRule ^logout/?$ pages/logout.php [L]
RewriteRule ^error/?$ error.php [L,QSA]

# Error Documents
ErrorDocument 404 /web/error.php?code=404
ErrorDocument 403 /web/error.php?code=403
ErrorDocument 500 /web/error.php?code=500

# Admin routes
RewriteRule ^admin/?$ admin/index.php [L]
RewriteRule ^admin/banner/?$ admin/hero.php [L]
RewriteRule ^admin/hero/?$ admin/hero.php [L]
RewriteRule ^admin/classes/?$ admin/classes.php [L,QSA]
RewriteRule ^admin/news/?$ admin/news.php [L,QSA]
RewriteRule ^admin/activities/?$ admin/activities.php [L,QSA]
RewriteRule ^admin/teachers/?$ admin/teachers.php [L,QSA]
RewriteRule ^admin/club/?$ admin/club.php [L,QSA]
RewriteRule ^admin/users/?$ admin/users.php [L,QSA]
RewriteRule ^admin/settings/?$ admin/settings.php [L,QSA]

# Fallback for extensionless PHP files
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]
</IfModule>
