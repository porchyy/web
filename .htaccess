Options -Indexes -MultiViews

<FilesMatch "(?i)^(?:\..*|Screenshot.*\.(?:png|jpe?g|webp)|.*\.(?:log|bak|backup|zip|sql|env|md|json|lock|ini|yml|yaml|sh|bash))$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Force HTTPS in production (exclude localhost / 127.0.0.1 for local testing)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTP_HOST} !^(?:localhost|127\.0\.0\.1)(?::[0-9]+)?$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Reject private and executable paths before canonical redirects.
RewriteRule ^(?:\.scratch|scratch|database|includes|tests|tools|deploy|docs|dist|graphify-out|\.agents|\.codex|\.git)(?:/.*)?$ - [F,L,NC]
RewriteRule ^uploads/.*\.(?:php[0-9]?|phtml|phar|cgi|pl|py|sh)(?:[./]|$) - [F,L,NC]

# Redirect /index or index.php to root / (GET/HEAD only)
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/index(?:\.php)?[\s?] [NC]
RewriteRule ^ / [R=301,L]

# Redirect /admin/index or /admin/index.php to /admin (GET/HEAD only)
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/admin/index(?:\.php)?[\s?] [NC]
RewriteRule ^ /admin [R=301,L]

# Redirect /admin/index clean path to /admin (GET/HEAD only)
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
RewriteRule ^admin/index/?$ /admin [R=301,L]

# Redirect direct .php requests to clean URL (GET/HEAD only)
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# Redirect /index clean path to root (GET/HEAD only)
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
RewriteRule ^index/?$ / [R=301,L]

# Deny direct access to internal sensitive directories & files
RewriteRule \.(?:cache|sql|env|md|json|lock)$ - [F,L,NC]

# Existing files and directories serve directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Hide pages/ from URL if directly requested (GET/HEAD only)
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/pages/([^\s?]+)(?:\.php)? [NC]
RewriteRule ^ %1 [R=301,L]

# Public routes pointing to pages/
RewriteRule ^$ index.php [L]
RewriteRule ^about/?$ pages/about.php [L]
RewriteRule ^news/?$ pages/news.php [L]
RewriteRule ^news/([0-9]+)/?$ pages/news.php?id=$1 [L,QSA]
RewriteRule ^schedule/?$ pages/schedule.php [L,QSA]
RewriteRule ^teachers/?$ pages/teachers.php [L]
RewriteRule ^login/?$ pages/login.php [L]
RewriteRule ^logout/?$ pages/logout.php [L]
RewriteRule ^error/?$ error.php [L,QSA]

# Error Documents
ErrorDocument 404 /error.php?code=404
ErrorDocument 403 /error.php?code=403
ErrorDocument 500 /error.php?code=500

# Dedicated API micro-endpoints
RewriteRule ^api/admin/([a-zA-Z0-9_\-]+)/?$ api/admin/$1.php [L,QSA]
RewriteRule ^api/([a-zA-Z0-9_\-]+)/?$ api/$1.php [L,QSA]

# Admin routes
RewriteRule ^admin/?$ admin/index.php [L]
RewriteRule ^admin/banner/?$ admin/hero.php [L]
RewriteRule ^admin/hero/?$ admin/hero.php [L]
RewriteRule ^admin/classes/?$ admin/classes.php [L,QSA]
RewriteRule ^admin/news/?$ admin/news.php [L,QSA]
RewriteRule ^admin/activities/?$ admin/activities.php [L,QSA]
RewriteRule ^admin/teachers/?$ admin/teachers.php [L,QSA]
RewriteRule ^admin/club/?$ admin/club.php [L,QSA]
RewriteRule ^admin/users/?$ admin/users.php [L,QSA]
RewriteRule ^admin/settings/?$ admin/settings.php [L,QSA]

# Fallback for extensionless PHP files
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]
</IfModule>

# Production Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), camera=(), microphone=()"
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
</IfModule>

# Gzip / Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml application/rss+xml image/svg+xml font/woff font/woff2
</IfModule>

# Browser Caching & Expiration for Static Assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

