Options -Indexes -ExecCGI

<FilesMatch "(?i)\.(?:php[0-9]?|phtml|phar|cgi|pl|py|sh|bash|exe|jsp|asp|aspx|shtml|svgz|pht)(?:\.|$)">
  Require all denied
</FilesMatch>

<IfModule mod_php.c>
  php_flag engine off
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
</IfModule>
